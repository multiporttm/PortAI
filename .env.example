# PortAI configuration. Copy to .env (never commit it) or export these variables.

# Any OpenAI-compatible endpoint serving Apertus. Examples:
#   Public AI Inference Utility: https://api.publicai.co/v1
#   CSCS (Swiss National Supercomputing Centre): https://api.inference.cscs.ch/v1
#   Self-hosted vLLM / Ollama / llama.cpp:        http://localhost:8000/v1
PORTAI_API_BASE=https://api.publicai.co/v1
PORTAI_API_KEY=

# Comma-separated list of allowed models. The first one is the default.
PORTAI_MODELS=swiss-ai/apertus-70b-instruct,swiss-ai/apertus-8b-instruct

# Optional: friendly labels, same order as PORTAI_MODELS.
PORTAI_MODEL_LABELS=Apertus 70B,Apertus 8B

PORT=8080
HOST=127.0.0.1

# Requests per minute per client (in-memory, IPs are never stored in clear text).
PORTAI_RATE_LIMIT=30

# Set to 1 when served over HTTPS to send Strict-Transport-Security.
PORTAI_HSTS=0

# Set to 1 when running behind a trusted reverse proxy (uses X-Forwarded-For for rate limiting).
PORTAI_TRUST_PROXY=0

# Set to 1 to run without any upstream (echo replies) for local development.
PORTAI_MOCK=0
